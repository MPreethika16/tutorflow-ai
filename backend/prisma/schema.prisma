generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum UserRole {
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuestionType {
  MCQ
  TYPED
  VOICE
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum EvaluationStatus {
  PENDING
  EVALUATING
  WAITING_FOR_REVIEW
  APPROVED
  FAILED
}

enum AssessmentKind {
  PRACTICE
  TEST
}

enum ContentSource {
  MANUAL
  AI_GENERATED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String     @db.VarChar(100)
  lastName     String     @db.VarChar(100)
  email        String?    @unique @db.VarChar(255)
  passwordHash String     @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  teacher Teacher?
  student Student?

  @@map("users")
}

model Teacher {
  userId      String   @id @db.Uuid
  phoneNumber String?  @db.VarChar(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  students    Student[]
  assessments Assessment[]

  @@map("teachers")
}

model Student {
  userId             String   @id @db.Uuid
  teacherId          String   @db.Uuid
  studentId          String   @unique @db.VarChar(50)
  board              String   @db.VarChar(100)
  grade              String   @db.VarChar(50)
  rollNumber         String?  @db.VarChar(50)
  parentName         String?  @db.VarChar(200)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [userId], onDelete: Restrict)

  attempts AssessmentAttempt[]

  @@index([teacherId])
  @@index([teacherId, board, grade])
  @@map("students")
}

model Assessment {
  id              String           @id @default(uuid()) @db.Uuid
  assessmentId    String           @unique
  teacherId       String           @db.Uuid
  title           String
  description     String?
  board           String
  grade           String
  subject         String
  kind            AssessmentKind   @default(PRACTICE)
  source          ContentSource    @default(MANUAL)
  durationMinutes Int?
  instructions    String?
  maximumMarks    Int              @default(0)
  startAt         DateTime?
  endAt           DateTime?
  status          AssessmentStatus @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  teacher         Teacher          @relation(fields: [teacherId], references: [userId], onDelete: Restrict)

  questions Question[]
  attempts  AssessmentAttempt[]

  @@index([teacherId])
  @@index([teacherId, status])
  @@index([board, grade, subject])
}

model Question {
  id                  String       @id @default(uuid()) @db.Uuid
  questionId          String       @unique
  assessmentId        String       @db.Uuid
  type                QuestionType
  prompt              String
  marks               Int
  order               Int
  options             Json?
  correctOption       String?
  explanation         String?
  modelAnswer         String?
  gradingInstructions String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  embedding Unsupported("vector(1536)")?

  assessment     Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
  @@index([assessmentId, type])
}

model AssessmentAttempt {
  id            String                  @id @default(uuid()) @db.Uuid
  attemptId     String                  @unique
  studentUserId String                  @db.Uuid
  assessmentId  String                  @db.Uuid
  status        AssessmentAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime
  expiresAt     DateTime
  submittedAt   DateTime?
  publishedAt   DateTime?
  finalMarks    Int?
  maximumMarks  Int?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  student    Student    @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  answers StudentAnswer[]

  @@unique([studentUserId, assessmentId])
  @@index([assessmentId])
}

model StudentAnswer {
  id             String   @id @default(uuid()) @db.Uuid
  attemptId      String   @db.Uuid
  questionId     String   @db.Uuid
  selectedOption String?
  textAnswer     String?
  voiceUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  evaluation AnswerEvaluation?

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model AnswerEvaluation {
  id              String @id @default(uuid()) @db.Uuid
  studentAnswerId String @unique @db.Uuid

  aiMarks      Int?
  aiFeedback   String?
  aiReasoning  String?
  aiConfidence Float?

  teacherMarks    Int?
  teacherFeedback String?

  status EvaluationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentAnswer StudentAnswer @relation(fields: [studentAnswerId], references: [id], onDelete: Cascade)

  @@index([status])
}
